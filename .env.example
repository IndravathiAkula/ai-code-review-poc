# GitHub PAT with "Models: read" permission (fine-grained token).
# Also used for PyGithub to read/post PR comments if you run locally.
GITHUB_TOKEN=ghp_replace_me

# GitHub Models inference endpoint. Leave as-is unless you're on a
# private Azure AI Inference deployment.
MODEL_ENDPOINT=https://models.github.ai/inference

# Default model for local runs.
DEFAULT_MODEL=openai/gpt-4o-mini

# Default provider. Known: github-models (default), openai, groq,
# openrouter, nvidia, together, anyscale, cerebras, ollama, custom.
# For 'custom', also set REVIEWER_BASE_URL and REVIEWER_API_KEY_ENV.
REVIEWER_PROVIDER=github-models

# Provider API keys. Only set the ones you actually use.
# ANTHROPIC_API_KEY=sk-ant-...   # Claude with prompt caching enabled
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# NVIDIA_API_KEY=nvapi-...
# TOGETHER_API_KEY=...
# ANYSCALE_API_KEY=...
# CEREBRAS_API_KEY=...

# For REVIEWER_PROVIDER=custom (any OpenAI-compatible endpoint, e.g.
# a self-hosted vLLM or LiteLLM gateway):
# REVIEWER_BASE_URL=https://my-endpoint.example.com/v1
# REVIEWER_API_KEY_ENV=MY_CUSTOM_KEY

# Minimum confidence for a finding to be posted (0.0 - 1.0).
MIN_CONFIDENCE=0.6

# Minimum severity for a finding to be posted: low | medium | high | critical.
# Confidence and severity are independent floors — both must pass.
MIN_SEVERITY=low

# Max chunks reviewed in parallel. Bump up for big PRs, down to dodge rate
# limits.
REVIEWER_CONCURRENCY=4

# Files whose diff exceeds this many characters are split per-hunk so each
# request stays under the model's prompt budget.
REVIEWER_MAX_DIFF_CHARS=8000

# Retry budget for transient errors (429, 5xx, connection drops). Sleep
# grows exponentially: base, base*2, base*4, ... unless the server returns
# a Retry-After header.
REVIEWER_MAX_RETRIES=3
REVIEWER_RETRY_BASE_SECONDS=1.0

# Cost caps — 0 = unlimited. Defense against a 200-file PR or a
# runaway prompt that would otherwise generate $50 of reviews.
# REVIEWER_MAX_FILES_PER_PR: pre-flight cap — extra chunks skipped
# before any model call.
# REVIEWER_MAX_TOKENS_PER_PR: runtime cap — workers stop submitting
# new model calls once cumulative token usage hits the cap.
REVIEWER_MAX_FILES_PER_PR=0
REVIEWER_MAX_TOKENS_PER_PR=0

# Post a single PR-level summary comment with token / cost / latency
# totals. Idempotent — updates the existing comment in place on re-runs.
REVIEWER_POST_SUMMARY=true

# Path the CI script writes the run artifact (JSON) to. The workflow
# uploads this file via actions/upload-artifact for offline analysis.
REVIEWER_ARTIFACT_PATH=ai-review-run.json

# Extra glob patterns (comma-separated, full-path) that should NEVER be
# sent to the model. Built-in defaults already cover .env files, *.pem /
# *.key / id_rsa, and secrets/, credentials/, .ssh/, .aws/ directories;
# this is for repo-specific additions.
# Example: REVIEWER_BLOCK_PATTERNS=*infra/prod/*,*generated/*.sql
REVIEWER_BLOCK_PATTERNS=
