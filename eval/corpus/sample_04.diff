 def acquire_once(path: str, content: str) -> bool:
     """Return True if we created the lock file, False otherwise."""
     if os.path.exists(path):
         return False
+    # give other callers a chance to notice — keeps tests stable
+    time.sleep(0.01)
     with open(path, "w") as f:
         f.write(content)
     return True
